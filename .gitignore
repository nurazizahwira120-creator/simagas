# Kredensial service account Firebase — JANGAN PERNAH ter-commit.
# Berkas ini setara kunci rumah: pemegangnya bisa mengirim notifikasi
# atas nama sekolah ke seluruh HP wali murid.
/firebase*.json
/*firebase-adminsdk*.json
/storage/app/firebase*.json
/rahasia/

# Folder unduhan dari sesi Claude. Isinya salinan .env yang memuat
# PUSHER_APP_SECRET — kalau ikut ter-commit, kunci itu terbuka di GitHub
# untuk SELAMANYA: menghapusnya di commit berikutnya tidak cukup, ia tetap
# ada di riwayat, dan kunci yang pernah ter-push harus diganti.
/Claude outputs/

# Arsip .zip tidak perlu masuk repository. Yang sudah terlanjur terlacak
# (vendor.zip, absensi-smk.zip) TIDAK terpengaruh baris ini — aturan
# .gitignore hanya berlaku untuk berkas yang belum dilacak.
*.zip

# Berkas bernama `laravel` di akar project adalah DATABASE SQLITE lokal
# (bukan installer Laravel seperti dugaan semula). Ia tercipta kalau .env
# di PC memakai DB_CONNECTION=sqlite dengan DB_DATABASE=laravel — Laravel
# lalu membuat berkas database bernama persis "laravel" di folder project.
#
# Berkas ini SEMPAT terlacak Git (baris di bawah tidak berlaku untuk berkas
# yang sudah terlacak) dan ikut ter-push ke GitHub serta ke server setiap
# deploy. Sudah dikeluarkan dengan `git rm --cached laravel`: berkasnya
# tetap ada di PC sebagai database lokal, hanya tidak ikut Git lagi.
/laravel
/composer.phar

# Skrip bantu sekali pakai buatan sesi ini.
/1-KIRIM-KE-GITHUB.bat

# Seeder DATA DEMO — khusus komputer lokal, TIDAK PERNAH ikut ke GitHub
# maupun server hosting. Isinya akun-akun berpassword "password"; kalau
# sampai terkirim, siapa pun bisa login sebagai kepala sekolah di server.
# DatabaseSeeder hanya memanggilnya bila berkas ini ADA dan APP_ENV=local,
# jadi `php artisan db:seed` di server tetap berjalan normal tanpanya.
/database/seeders/DataDemoSeeder.php

# Log galat PHP bawaan hosting (cPanel menulis `error_log` di folder tempat
# skrip PHP berjalan). public/error_log SEMPAT ikut ter-commit — isinya
# jalur folder server (/home/<akun>/...), informasi yang tidak perlu ada di
# repository. Sudah dikeluarkan dengan `git rm public/error_log`.
error_log

# Database SQLite lokal (dipakai saat pengujian / percobaan di PC).
/database/*.sqlite
/database/*.sqlite-journal
